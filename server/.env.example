HOST=0.0.0.0
PORT=3108
# Host loopback port can differ from the container port.
FLOWDAY_HOST_PORT=3108
DATABASE_PATH=/app/data/flowday.sqlite
# Comma-separated exact origins; leave empty for native clients only.
CORS_ORIGIN=
# Optional OpenAI-compatible endpoint including /v1; configure all three.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Optional Feishu custom bot webhook. Keep server-side only.
FEISHU_WEBHOOK_URL=
# Optional legacy default bot signature. Each user can configure their own bot.
FEISHU_WEBHOOK_SECRET=
# Required to save per-user integration credentials: random 32 bytes as 64 hex characters.
INTEGRATION_ENCRYPTION_KEY=
# Required for expiring reminder action links: random secret at least 24 characters.
ACTION_SIGNING_KEY=
# Microsoft 365 application mail sender; restrict Mail.Send to the sender mailbox.
MAIL_FROM=flowday-noreply@mtrx.pro
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Public HTTPS origin for the action confirmation links.
PUBLIC_BASE_URL=
# Optional directory for daily consistent SQLite snapshots, including attachment bytes.
SNAPSHOT_DIR=/app/data/snapshots
# Optional additional HTTPS CalDAV hosts, exact names separated by commas.
# iCloud caldav.icloud.com and pNN-caldav.icloud.com are allowed by default.
CALDAV_ALLOWED_HOSTS=
# Background Apple calendar sync interval (minimum 60 seconds).
CALDAV_SYNC_INTERVAL_MS=300000
