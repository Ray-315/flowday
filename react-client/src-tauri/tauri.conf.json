{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlowDay",
  "version": "0.2.0",
  "identifier": "pro.flowday.react-trial",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "FlowDay",
      "width": 1440,
      "height": 960,
      "minWidth": 390,
      "minHeight": 600,
      "backgroundColor": "#f5f6f8"
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {"nsis": {"installMode": "currentUser", "languages": ["SimpChinese", "English"]}},
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
